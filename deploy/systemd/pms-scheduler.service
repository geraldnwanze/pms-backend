# Copy to /etc/systemd/system/, change the paths and user, then:  systemctl enable --now pms-scheduler
[Unit]
Description=PMS scheduler (invoices, reminders, late fees, auto-debit, heartbeat)
After=network.target postgresql.service

[Service]
User=www-data
WorkingDirectory=/var/www/pms-backend
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
