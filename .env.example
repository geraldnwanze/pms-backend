APP_NAME=EstateHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres via docker-compose (docker compose up -d)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=pms
DB_USERNAME=pms
DB_PASSWORD=pms

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@estatehub.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated list of frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3020,http://127.0.0.1:3000,http://127.0.0.1:3020

FRONTEND_URL=http://localhost:3020

# Web Push (VAPID) — generate with: php -r 'require "vendor/autoload.php"; print_r(Minishlink\\WebPush\\VAPID::createVapidKeys());'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@estatehub.test

# Paystack (test keys from dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Seeder: keep the bundled demo dataset at its original fixed dates (2026-08-25) instead of rolling it forward to today.
# SEED_FIXED_DATES=false

# "I'm not a robot" challenge (Cloudflare Turnstile) on sign-in, register, forgot-password and reset-password.
# Create a free Turnstile widget (Managed mode) at https://dash.cloudflare.com/?to=/:account/turnstile and list your domains there.
# While TURNSTILE_ENABLED is false nothing is asked for. Once true, a missing or unverifiable challenge blocks the request.
# Cloudflare's public TEST keys (these always pass; "2x…" site key always blocks, "3x…" forces an interactive challenge) are below for local development:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Serve the API docs (/docs/api) outside the local environment, e.g. on a staging site. Leave false where the API is public.
API_DOCS_PUBLIC=false
